<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Fork: neverForLocation is a promise to the framework that we never use a scan result to
         work out where the phone is, and in return Android 12+ stops gating scan results on the
         master Location toggle. Without it, receiving with Location off left the app scanning for
         ever: startScan() returned success, onScanFailed never fired, and not one result was
         delivered while the sender advertised a metre away. The documented cost is that some
         beacon formats are filtered out of the results; we look for a plain 128-bit service UUID,
         which is not one of them. Below API 31 the flag does not exist and the Location toggle
         still governs every scan result — locationEnabledForScanning() covers that case. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Fork: WifiP2pManager reads group state through this. It has been arriving by manifest
         merge from a dependency rather than being asked for here, which is not something the
         Wi-Fi Direct hotspot path should rely on. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!--
      Android 17 blocks local network access by default for apps targeting SDK 37, and every
      transfer this app performs is local-network traffic: the hotspot peer at the gateway
      address, plus shared network mode's UDP discovery and TCP. Apps targeting 36 or lower got
      an implicit grant via INTERNET, which is why this was not needed before the v10 targetSdk
      bump (#137). Unknown permissions are ignored on older releases, so no maxSdkVersion guard
      is wanted here; the runtime request is what has to be version-gated.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Fork: location is only ever wanted for WiFi here, and only up to Android 12L —
         startLocalOnlyHotspot() takes NEARBY_WIFI_DEVICES instead from API 33, and BLE scanning
         stopped needing location at all once BLUETOOTH_SCAN carried neverForLocation (above).
         Declaring these on 33+ would tie the app back to location for nothing, and the scan
         disavowal is a weaker promise while they are held. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- required for the MulticastLock used by shared network discovery -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Fork: the Export / Import page writes its backup .zip into the folder 白い熊 picks (a real
         path, not a SAF tree), and 自由作業盤's 保存復元 run may hand this app an absolute `path` to
         write to. Both need All-Files-Access — the same reason renrakusaki and kxkb declare it. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application

        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlyingCarpet">
        <!-- Fork: singleTask so a share from the file manager reuses the running Activity through
             onNewIntent() instead of starting a second instance. A second instance brings its own
             ViewModel, its own Bluetooth object and therefore its own openGattServer(), which put a
             second copy of our GATT service in the database; the peer could then discover and read
             the copy belonging to the server we no longer answer through, and the handshake stalled
             in silence. onNewIntent() was already written for this and could never fire without it. -->
        <activity
            android:name="dev.spiegl.flyingcarpet.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Fork: appear in the system share sheet, so files picked in a file manager (or any
                 other app) can be sent straight from there. Any type, one file or many. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <activity
            android:name="dev.spiegl.flyingcarpet.SettingsActivity"
            android:exported="false"
            android:label="@string/uiSettingsTitle"
            android:theme="@style/Theme.FlyingCarpet.Settings" />
        <!-- Fork: the sister-app state-export automation contract. No android:permission — the
             caller (白い熊 自由作業盤) cannot hold one; the token in AutomationAuth is the gate, and
             the master switch on the UI page defaults to OFF. -->
        <receiver
            android:name="dev.spiegl.flyingcarpet.StateExportReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.action.EXPORT_STATE" />
                <action android:name="${applicationId}.action.LIST_CATEGORIES" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:replace="screenOrientation" />

    </application>

</manifest>